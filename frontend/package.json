{
  "name": "dark-pattern-analyzer-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:taxonomy": "node scripts/generate-taxonomy.mjs",
    "generate:roles": "node scripts/generate-roles.mjs",
    "predev": "npm run generate:taxonomy && npm run generate:roles",
    "prebuild": "npm run generate:taxonomy && npm run generate:roles",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@wxt-dev/module-react": "^1.1.0",
    "autoprefixer": "^10.4.19",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3",
    "wxt": "^0.19.13"
  }
}
