# Dark Pattern Analyzer -- backend configuration
# Copy to backend/.env. Every variable is prefixed DP_.

# --- artifact bundle (Stage 1 output) --------------------------------------
# Path to the verified bundle. Relative paths resolve from backend/.
DP_MODEL_DIR=../ml/artifacts/model_v1

# Must match manifest.json exactly. Startup aborts on mismatch, because this
# value is baked into every cache key -- a silent mismatch serves stale
# predictions after a retrain.
DP_MODEL_VERSION=1.0.0

# precision | balanced | recall
# precision is the shipped default: a false positive that accuses an honest site
# destroys trust in the tool immediately. "recall" is measurably bad for
# social_proof (validation precision 0.230) and is only there for experiments.
DP_THRESHOLD_PROFILE=precision

# --- serving ---------------------------------------------------------------
# Max snippets per request and ONNX batch chunk size.
DP_MAX_BATCH=64

# onnxruntime intra-op threads. 0 lets ORT decide. Set to the container's CPU
# limit when running under a cgroup, since ORT otherwise sizes to the host.
DP_ONNX_INTRA_OP_THREADS=0

# --- cache -----------------------------------------------------------------
# 7 days. Bumping DP_MODEL_VERSION invalidates everything regardless.
DP_CACHE_TTL=604800
DP_CACHE_MAX_ENTRIES=50000

# --- ops -------------------------------------------------------------------
DP_LOG_LEVEL=INFO

# JSON array. Empty disables CORS entirely. The extension needs its own origin
# listed, e.g. ["chrome-extension://<id>"].
DP_CORS_ORIGINS=[]

# --- deferred --------------------------------------------------------------
# Declared now so the env contract does not change later. Both are read and
# logged, but neither is wired up in Stage 2.
# Redis cache backend: Stage 2 hardening.
# DP_REDIS_URL=redis://localhost:6379/0
# Findings persistence and POST /v1/feedback: Stage 4.
# DP_DATABASE_URL=postgresql://localhost:5432/darkpatterns
DP_PERSIST_FINDINGS=true
