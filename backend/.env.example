# Dark Pattern Analyzer -- backend configuration
# Copy to backend/.env. Every variable is prefixed DP_.

# --- artifact bundle (Stage 1 output) --------------------------------------
# Path to the verified bundle. Relative paths resolve from backend/.
DP_MODEL_DIR=../ml/artifacts/model_v1

# Must match manifest.json exactly. Startup aborts on mismatch, because this
# value is baked into every cache key -- a silent mismatch serves stale
# predictions after a retrain.
DP_MODEL_VERSION=1.0.0

# precision | balanced | recall
# precision is the shipped default: a false positive that accuses an honest site
# destroys trust in the tool immediately. "recall" is measurably bad for
# social_proof (validation precision 0.230) and is only there for experiments.
DP_THRESHOLD_PROFILE=precision

# --- serving ---------------------------------------------------------------
# Max snippets per request and ONNX batch chunk size.
DP_MAX_BATCH=64

# onnxruntime intra-op threads. 0 lets ORT decide. Set to the container's CPU
# limit when running under a cgroup, since ORT otherwise sizes to the host.
DP_ONNX_INTRA_OP_THREADS=0

# --- cache -----------------------------------------------------------------
# 7 days. Bumping DP_MODEL_VERSION invalidates everything regardless.
DP_CACHE_TTL=604800
DP_CACHE_MAX_ENTRIES=50000

# --- ops -------------------------------------------------------------------
DP_LOG_LEVEL=INFO

# JSON array. Empty disables CORS entirely. The extension needs its own origin
# listed, e.g. ["chrome-extension://<id>"].
DP_CORS_ORIGINS=[]

# --- LLM explanations (POST /v1/explain) -----------------------------------
# Off by default. When false the endpoint returns 503 with a reason and the
# extension shows that reason instead of a generic failure.
DP_LLM_ENABLED=false

# Groq, over its OpenAI-compatible endpoint. Any other OpenAI-compatible
# provider works by changing these two, but Groq is what this is tested for.
DP_LLM_BASE_URL=https://api.groq.com/openai/v1
# Groq's catalogue changes -- see https://console.groq.com/docs/models if this
# model stops resolving.
DP_LLM_MODEL=llama-3.3-70b-versatile

# A real secret. Get one at https://console.groq.com/keys.
# Read on the server only: it never reaches the extension bundle, which is
# readable by anyone who installs it. backend/.env is gitignored -- keep it
# that way, and never commit a key.
DP_LLM_API_KEY=

# Groq is fast; generous enough to absorb a queue spike without leaving the
# UI's pending state hanging indefinitely.
DP_LLM_TIMEOUT=45
DP_LLM_MAX_TOKENS=400
DP_LLM_TEMPERATURE=0.2
DP_LLM_CACHE_MAX_ENTRIES=2000

# --- trace storage (POST /v1/traces) ---------------------------------------
# Archives each page scan's full extraction trace to MinIO, with a SQLite
# index that makes captures findable by host and label.
#
# PRIVACY: traces contain real text from pages the user visited. This is off by
# default, and the extension only uploads when the user presses its "Save this
# scan to the archive" button -- there is no automatic path.
#
#   docker compose up -d minio     # from the repo root
#   console: http://localhost:9001
DP_MINIO_ENABLED=false

# S3 API port (9000), not the web console port (9001).
DP_MINIO_ENDPOINT=http://localhost:9000
DP_MINIO_ACCESS_KEY=minioadmin
DP_MINIO_SECRET_KEY=minioadmin
DP_MINIO_BUCKET=dp-traces
DP_MINIO_REGION=us-east-1

# SQLite index of stored traces. Derived data -- deleting it loses no traces,
# it can be rebuilt from the bucket.
DP_TRACE_INDEX_PATH=./trace_index.db

# Reject payloads larger than this. A large page's trace is ~1-2 MB.
DP_TRACE_MAX_BYTES=33554432

# --- deferred --------------------------------------------------------------
# Declared now so the env contract does not change later. Both are read and
# logged, but neither is wired up in Stage 2.
# Redis cache backend: Stage 2 hardening.
# DP_REDIS_URL=redis://localhost:6379/0
# Findings persistence and POST /v1/feedback: Stage 4.
# DP_DATABASE_URL=postgresql://localhost:5432/darkpatterns
DP_PERSIST_FINDINGS=true
